{
    "name": "nileshvalva/nativephp-otp-autofill",
    "version": "1.0.0",
    "description": "Automatically detects and fills OTP codes from incoming SMS messages on Android and iOS",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Nilesh Valva",
            "email": "info@nileshvalva.in"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Nativephp\\OtpAutofill\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nativephp\\OtpAutofill\\OtpAutofillServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}